NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_RTDB_URL=
NEXT_PUBLIC_FIREBASE_APP_ID=
# These values are PUBLIC (they are inlined into the browser bundle). They are
# safe only when the RTDB rules in database.rules.json are deployed and the API
# key is restricted to your domains in Google Cloud. See docs/FIREBASE_HARDENING.md.
#
# Left empty, Roomcade runs on a local same-browser backend (localStorage) so two
# tabs can still complete the full flow. With values set, room metadata and live
# game state use the Firebase Realtime Database + Anonymous Auth.
