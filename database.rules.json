{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      ".read": false,
      ".write": "auth != null",

      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",

        "meta": {
          "code": {
            ".write": "auth != null && !data.exists()",
            ".validate": "newData.isString() && newData.val() === $code && newData.val().length === 5"
          },

          "hostId": {
            ".write": "auth != null && data.parent().child('players').child(auth.uid).exists() && (data.val() === auth.uid || !data.parent().child('players').child(data.val()).exists())",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 64"
          },

          "status": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
            ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'in-game' || newData.val() === 'recap')"
          },

          "currentGameId": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 40)"
          },

          "selectedGameId": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
            ".validate": "newData.val() === null || (newData.isString() && newData.val().length > 0 && newData.val().length <= 40)"
          },

          "round": {
            ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
          },

          "updatedAt": {
            ".write": "auth != null && data.parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.isNumber() && newData.val() > 1600000000000"
          },

          "players": {
            ".write": "auth != null",
            "$uid": {
              ".write": "auth != null && $uid === auth.uid",

              ".validate": "newData.hasChildren(['uid', 'name', 'avatarColor', 'score'])",

              "uid": {
                ".validate": "newData.isString() && newData.val() === $uid && newData.val().length <= 64"
              },
              "name": {
                ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 24"
              },
              "avatarColor": {
                ".validate": "newData.isString() && newData.val().matches(/^#[0-9A-Fa-f]{6}$/)"
              },
              "avatarId": {
                ".validate": "newData.val() === null || (newData.isString() && newData.val().length <= 40)"
              },
              "score": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999999 && newData.val() >= (root.child('rooms').child($code).child('meta').child('players').child($uid).child('score').val() == null ? 0 : root.child('rooms').child($code).child('meta').child('players').child($uid).child('score').val())"
              },
              "joinedAt": {
                ".validate": "newData.isNumber()"
              },
              "lastSeen": {
                ".validate": "newData.isNumber()"
              },
              "online": {
                ".validate": "newData.isBoolean()"
              },
              "$other": {
                ".validate": false
              }
            }
          },

          "$other": {
            ".validate": false
          }
        },

        "live": {
          ".write": "auth != null && root.child('rooms').child($code).child('meta').child('players').child(auth.uid).exists() && (newData.exists() || root.child('rooms').child($code).child('meta').child('hostId').val() === auth.uid)",
          ".validate": "newData.isString() && newData.val().length <= 30000"
        },

        "presence": {
          ".write": false,

          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('rooms').child($code).child('meta').child('players').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['at']) && newData.child('at').isNumber()"
          }
        }
      }
    }
  }
}